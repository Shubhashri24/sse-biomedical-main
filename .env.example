# ==============================================================================
# Shree Shyam Electronics — Biomedical Systems Catalog
# Environment Variables Configuration
# Copy this file to .env.local and fill in the values.
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sse_biomedical?retryWrites=true&w=majority
MONGODB_URI=

# Administrator Notification Email
# All new customer quotation requests will trigger an alert to this email address.
ADMIN_EMAIL=

# Admin Authentication Credentials
# Used to log into the protected admin portal at /admin/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session Secret (Used for cryptographic HMAC token signing)
# Generate a random 32+ character string
SESSION_SECRET=

# SMTP Server Configuration (Used for sending admin alerts and customer replies)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@shreeshyamelectronics.com
